# Application
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/showtime
# Pour MongoDB Atlas : mongodb+srv://username:password@cluster.mongodb.net/showtime?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# SMTP Email Configuration
# Pour Gmail, utilisez : smtp.gmail.com
# Pour Outlook/Hotmail : smtp-mail.outlook.com
# Pour Yahoo : smtp.mail.yahoo.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
SMTP_FROM=noreply@showtime.com

