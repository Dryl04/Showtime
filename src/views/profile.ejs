<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mon Profil - My Show Time</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: "Poppins", sans-serif;
        }
        
        .profile-card {
            transition: all 0.3s ease;
        }
        
        .profile-card:hover {
            transform: translateY(-4px);
        }
    </style>
</head>

<body class="bg-blue-100 min-h-screen flex flex-col">
    <header class="bg-blue-600 text-white p-4 shadow-md">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-semibold">My Show Time</h1>
            <nav>
                <a href="/" class="text-white hover:text-gray-200 mx-2 font-bold  pb-1">Accueil</a>
                <a href="/users/me" class="text-white hover:text-gray-200 mx-2 font-bold border-b-2 border-white pb-1">Profil</a>

            </nav>
            <form action="/auth/logout" method="post">
                <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                                Déconnexion
                            </button>
            </form>
        </div>
    </header>

    <main class="flex-grow container mx-auto p-6 mt-10 bg-white rounded-2xl shadow-lg max-w-3xl">
        <div class="text-center mb-8">
            <img src="<%= user.photo_url || '/default-avatar.png' %>" alt="Photo de profil" class="w-28 h-28 mx-auto rounded-full border-4 border-blue-600 object-cover" />
            <h2 class="text-3xl font-bold text-gray-800 mt-4">
                <%= user.name %>
            </h2>
            <p class="text-gray-600">
                <%= user.email %>
            </p>
            <p class="mt-2">
                <span class="bg-blue-100 text-blue-700 text-sm px-3 py-1 rounded-full">
          <%= user.roles.join(', ') %>
        </span>
            </p>
        </div>

        <hr class="my-6" />

        <section class="space-y-3 text-gray-700 mb-8">
            <p><strong>Créé le :</strong>
                <%= new Date(user.createdAt).toLocaleDateString() %>
            </p>
            <p><strong>Dernière mise à jour :</strong>
                <%= new Date(user.updatedAt).toLocaleDateString() %>
            </p>
        </section>

        <hr class="my-6" />

        <h3 class="text-xl font-semibold text-gray-800 mb-4">Modifier mes informations</h3>

        <form method="POST" action="/users/name?_method=PUT" class="profile-card bg-gray-50 p-4 rounded-xl shadow-sm mb-5">
            <label class="block text-gray-700 font-medium mb-2">Nom</label>
            <input type="text" name="name" placeholder="Nouveau nom" minlength="2" maxlength="100" pattern="[A-Za-zÀ-ÿ\s'-]+" title="Le nom doit contenir uniquement des lettres (2-100 caractères)" class="w-full border border-gray-300 rounded-lg p-2 mb-3 focus:ring-2 focus:ring-blue-500"
            />
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">Mettre à jour le nom</button>
        </form>

        <form method="POST" action="/users/email?_method=PUT" class="profile-card bg-gray-50 p-4 rounded-xl shadow-sm mb-5">
            <label class="block text-gray-700 font-medium mb-2">Email</label>
            <input type="email" name="email" placeholder="Nouvel email" maxlength="255" title="Veuillez entrer une adresse e-mail valide (max 255 caractères)" class="w-full border border-gray-300 rounded-lg p-2 mb-3 focus:ring-2 focus:ring-blue-500" />
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">Mettre à jour l'email</button>
        </form>

        <form method="POST" action="/users/password?_method=PUT" class="profile-card bg-gray-50 p-4 rounded-xl shadow-sm mb-5">
            <label class="block text-gray-700 font-medium mb-2">Ancien mot de passe</label>
            <input type="password" name="oldPassword" placeholder="Ancien mot de passe" required minlength="6" maxlength="100" title="Mot de passe requis (6-100 caractères)" class="w-full border border-gray-300 rounded-lg p-2 mb-3 focus:ring-2 focus:ring-blue-500"
            />

            <label class="block text-gray-700 font-medium mb-2">Nouveau mot de passe</label>
            <input type="password" name="newPassword" placeholder="Nouveau mot de passe" required minlength="6" maxlength="100" title="Le nouveau mot de passe doit contenir au moins 6 caractères (max 100)" class="w-full border border-gray-300 rounded-lg p-2 mb-3 focus:ring-2 focus:ring-blue-500"
            />

            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">Mettre à jour le mot de passe</button>
        </form>

        <hr class="my-6" />

        <form method="POST" action="/users/account?_method=DELETE" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');" class="text-center">
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg shadow transition-all">Supprimer mon compte</button>
        </form>
    </main>

    <footer class="bg-gray-900 text-gray-300 text-center py-4 mt-10">
        <p>©
            <%= new Date().getFullYear() %> My Show Time — Tous droits réservés.</p>
    </footer>
</body>

</html>