<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier le Groupe - MyShowTime</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">

    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/dashboard" class="flex items-center hover:text-blue-200 transition">
                        <i class="fas fa-arrow-left mr-3 text-xl"></i>
                        <h1 class="text-xl font-semibold">Retour au Dashboard</h1>
                    </a>
                </div>
                <div class="flex items-center">
                    <a href="/" class="hover:text-blue-200 transition">
                        <i class="fas fa-home mr-2"></i>Accueil
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="text-center mb-10">
            <div class="inline-block p-4 bg-blue-100 rounded-full mb-4">
                <i class="fas fa-edit text-blue-600 text-4xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-2">Modifier le Groupe</h1>
            <p class="text-gray-600">Modifiez les informations du groupe
                <%= group.name %>
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8">

            <% if (locals.error) { %>
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <p>
                            <%= error %>
                        </p>
                    </div>
                </div>
                <% } %>

                    <form action="/groups/<%= group._id %>?_method=PUT" method="POST" class="space-y-6">

                        <div>
                            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-users text-blue-600 mr-2"></i>Nom du Groupe *
          </label>
                            <input type="text" id="name" name="name" required value="<%= group.name %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex: The Beatles, Coldplay, Kendrick Lamar...">
                        </div>

                        <div>
                            <label for="genre" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-guitar text-blue-600 mr-2"></i>Genre Musical *
          </label>
                            <select id="genre" name="genre" required class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors appearance-none bg-white">
            <option value="rock" <%= group.genre === 'rock' ? 'selected' : '' %>>Rock</option>
            <option value="pop" <%= group.genre === 'pop' ? 'selected' : '' %>>Pop</option>
            <option value="k-pop" <%= group.genre === 'k-pop' ? 'selected' : '' %>>K-Pop</option>
            <option value="jazz" <%= group.genre === 'jazz' ? 'selected' : '' %>>Jazz</option>
            <option value="classique" <%= group.genre === 'classique' ? 'selected' : '' %>>Classique</option>
            <option value="electronique" <%= group.genre === 'electronique' ? 'selected' : '' %>>Electronique</option>
            <option value="hip-hop" <%= group.genre === 'hip-hop' ? 'selected' : '' %>>Hip-Hop</option>
            <option value="metal" <%= group.genre === 'metal' ? 'selected' : '' %>>Metal</option>
            <option value="reggae" <%= group.genre === 'reggae' ? 'selected' : '' %>>Reggae</option>
            <option value="blues" <%= group.genre === 'blues' ? 'selected' : '' %>>Blues</option>
            <option value="country" <%= group.genre === 'country' ? 'selected' : '' %>>Country</option>
            <option value="rnb" <%= group.genre === 'rnb' ? 'selected' : '' %>>R&B</option>
            <option value="indie" <%= group.genre === 'indie' ? 'selected' : '' %>>Indie</option>
            <option value="slam" <%= group.genre === 'slam' ? 'selected' : '' %>>Slam</option>
            <option value="zinli" <%= group.genre === 'zinli' ? 'selected' : '' %>>Zinli</option>
            <option value="toba" <%= group.genre === 'toba' ? 'selected' : '' %>>Toba</option>
            <option value="agbadja" <%= group.genre === 'agbadja' ? 'selected' : '' %>>Agbadja</option>
            <option value="autre" <%= group.genre === 'autre' ? 'selected' : '' %>>🎼 Autre</option>
          </select>
                        </div>

                        <div>
                            <label for="picture_url" class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-image text-blue-600 mr-2"></i>URL de l'Image *
          </label>
                            <input type="url" id="picture_url" name="picture_url" required value="<%= group.picture_url %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="https://example.com/image.jpg">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
            <i class="fas fa-eye text-blue-600 mr-2"></i>Prévisualisation
          </label>
                            <div class="border-2 border-gray-200 rounded-lg p-4 bg-gray-50">
                                <img id="preview-img" src="<%= group.picture_url %>" alt="Prévisualisation" class="w-full h-64 object-cover rounded-lg">
                            </div>
                        </div>

                        <div class="flex space-x-4 pt-4">
                            <button type="submit" class="flex-1 bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl">
            <i class="fas fa-save mr-2"></i>Sauvegarder
          </button>
                            <a href="/admin/dashboard" class="flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition-colors text-center">
                                <i class="fas fa-times mr-2"></i>Annuler
                            </a>
                        </div>

                    </form>
        </div>

    </div>

    <script>
        const pictureUrlInput = document.getElementById('picture_url');
        const previewImg = document.getElementById('preview-img');

        pictureUrlInput.addEventListener('input', function() {
            const url = this.value.trim();

            if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                previewImg.src = url;
            }
        });
    </script>

</body>

</html>