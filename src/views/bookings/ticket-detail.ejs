<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Ticket - MyShowTime</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
        
        @media print {
            .no-print {
                display: none;
            }
        }
    </style>
</head>

<body class="bg-gray-50">

    <header class="bg-blue-600 text-white p-4 shadow-md no-print">
        <div class="container mx-auto flex justify-between items-center">
            <h1 class="text-2xl font-semibold">
                <i class="fas fa-ticket-alt mr-2"></i>MyShowTime
            </h1>
            <a href="/" class="text-white hover:text-gray-200">
                <i class="fas fa-home mr-2"></i>Retour à l'accueil
            </a>
        </div>
    </header>

    <div class="container mx-auto px-4 py-8 max-w-4xl">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">

            <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-8 text-center">
                <div class="mb-4">
                    <i class="fas fa-check-circle text-6xl text-green-300"></i>
                </div>
                <h1 class="text-3xl font-bold mb-2">Ticket Confirmé</h1>
                <p class="text-blue-100">Réservation #
                    <%= booking._id.toString().substring(0, 8).toUpperCase() %>
                </p>
            </div>

            <div class="p-8">
                <div class="grid md:grid-cols-2 gap-8">

                    <div>
                        <% if (booking.concert_id.picture_url) { %>
                            <img src="<%= booking.concert_id.picture_url %>" alt="<%= booking.concert_id.name_concert %>" class="w-full h-64 object-cover rounded-lg shadow-md mb-6">
                            <% } %>

                                <h2 class="text-2xl font-bold text-gray-800 mb-4">
                                    <%= booking.concert_id.name_concert %>
                                </h2>

                                <div class="space-y-4">
                                    <div class="flex items-start">
                                        <i class="fas fa-users text-blue-600 mt-1 mr-3"></i>
                                        <div>
                                            <p class="text-sm text-gray-500">Artiste/Groupe</p>
                                            <p class="font-semibold text-gray-800">
                                                <%= booking.concert_id.name_group %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-start">
                                        <i class="fas fa-calendar text-blue-600 mt-1 mr-3"></i>
                                        <div>
                                            <p class="text-sm text-gray-500">Date & Heure</p>
                                            <p class="font-semibold text-gray-800">
                                                <%= new Date(booking.concert_id.date).toLocaleDateString('fr-FR', { 
                                            weekday: 'long', 
                                            year: 'numeric', 
                                            month: 'long', 
                                            day: 'numeric' 
                                        }) %>
                                            </p>
                                            <p class="text-gray-600">
                                                <%= new Date(booking.concert_id.date).toLocaleTimeString('fr-FR', {
                                            hour: '2-digit',
                                            minute: '2-digit'
                                        }) %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-start">
                                        <i class="fas fa-map-marker-alt text-blue-600 mt-1 mr-3"></i>
                                        <div>
                                            <p class="text-sm text-gray-500">Lieu</p>
                                            <p class="font-semibold text-gray-800">
                                                <%= booking.concert_id.place %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-start">
                                        <i class="fas fa-ticket-alt text-blue-600 mt-1 mr-3"></i>
                                        <div>
                                            <p class="text-sm text-gray-500">Nombre de billets</p>
                                            <p class="font-semibold text-gray-800">
                                                <%= booking.quantity %> billet
                                                    <%= booking.quantity > 1 ? 's' : '' %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-start">
                                        <i class="fas fa-money-bill-wave text-blue-600 mt-1 mr-3"></i>
                                        <div>
                                            <p class="text-sm text-gray-500">Prix total</p>
                                            <p class="font-semibold text-gray-800">
                                                <%= booking.total_price.toLocaleString('fr-FR') %> FCFA</p>
                                        </div>
                                    </div>
                                </div>
                    </div>

                    <div class="flex flex-col items-center justify-center bg-gray-50 rounded-lg p-6">
                        <h3 class="text-xl font-semibold text-gray-800 mb-4">Code QR de votre billet</h3>

                        <% if (booking.qr_code) { %>
                            <div class="bg-white p-4 rounded-lg shadow-md mb-4">
                                <img src="<%= booking.qr_code %>" alt="QR Code" class="w-64 h-64">
                            </div>
                            <p class="text-sm text-gray-600 text-center max-w-xs">
                                Présentez ce QR code à l'entrée du concert
                            </p>
                            <% } else { %>
                                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 text-center">
                                    <i class="fas fa-exclamation-triangle text-yellow-600 text-3xl mb-2"></i>
                                    <p class="text-yellow-800">QR code en cours de génération...</p>
                                </div>
                                <% } %>
                    </div>

                </div>

                <div class="mt-8 pt-6 border-t border-gray-200 flex flex-wrap gap-4 justify-center no-print">
                    <button onclick="window.print()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg shadow-md transition flex items-center">
                        <i class="fas fa-print mr-2"></i>
                        Imprimer le ticket
                    </button>

                    <a href="/bookings/my-bookings" class="bg-gray-600 hover:bg-gray-700 text-white px-6 py-3 rounded-lg shadow-md transition flex items-center">
                        <i class="fas fa-list mr-2"></i> Mes réservations
                    </a>

                    <a href="/" class="bg-green-600 hover:bg-green-700 text-white px-6 py-3 rounded-lg shadow-md transition flex items-center">
                        <i class="fas fa-home mr-2"></i> Accueil
                    </a>
                </div>

            </div>
        </div>
</body>

</html>