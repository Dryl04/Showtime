<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Réservations - MyShowTime</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: "Poppins", sans-serif;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-gray-50">

    <header class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center space-x-3">
                    <div class="bg-white rounded-full p-2 shadow-lg">
                        <i class="fas fa-ticket-alt text-blue-600 text-xl"></i>
                    </div>
                    <span class="text-xl font-bold">My Show Time</span>
                </a>

                <nav class="hidden md:flex items-center space-x-6">
                    <a href="/" class="text-white hover:text-blue-200 font-medium transition">Concerts</a>
                    <a href="/groups" class="text-white hover:text-blue-200 font-medium transition">Groupes</a>
                    <a href="/wishlist" class="text-white hover:text-blue-200 font-medium transition">Wishlist</a>
                    <a href="/bookings/my-bookings" class="text-blue-200 font-medium border-b-2 border-white">Mes Réservations</a>
                </nav>

                <div class="flex items-center space-x-4">
                    <a href="/users/me" class="text-white hover:text-blue-200 transition">
                        <i class="fas fa-user mr-2"></i>
                        <%= user.name %>
                    </a>
                    <form action="/auth/logout" method="post" class="inline">
                        <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                            Déconnexion
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="text-center mb-10">
            <div class="inline-block p-4 bg-blue-100 rounded-full mb-4">
                <i class="fas fa-ticket-alt text-blue-600 text-5xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-2">Mes Réservations</h1>
            <p class="text-lg text-gray-600">Gérez vos billets et vos réservations</p>
        </div>

        <% if (bookings && bookings.length > 0) { %>
            <div class="grid grid-cols-1 gap-6">
                <% bookings.forEach(booking => { %>
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition">
                        <div class="flex flex-col md:flex-row">
                            <div class="md:w-1/4 relative">
                                <% if (booking.concert_id.picture_url) { %>
                                    <img src="<%= booking.concert_id.picture_url %>" alt="<%= booking.concert_id.name_concert %>" class="w-full h-48 md:h-full object-cover">
                                    <% } else { %>
                                        <div class="w-full h-48 md:h-full bg-blue-600 flex items-center justify-center">
                                            <i class="fas fa-music text-white text-6xl"></i>
                                        </div>
                                        <% } %>

                                            <div class="absolute top-4 right-4">
                                                <% if (new Date(booking.concert_id.date) > new Date()) { %>
                                                    <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                                            <i class="fas fa-check-circle mr-1"></i>Confirmé
                                        </span>
                                                    <% } else { %>
                                                        <span class="bg-gray-500 text-white px-3 py-1 rounded-full text-sm font-semibold">
                                            <i class="fas fa-history mr-1"></i>Passé
                                        </span>
                                                        <% } %>
                                            </div>
                            </div>

                            <div class="flex-1 p-6">
                                <div class="flex flex-col md:flex-row justify-between">
                                    <div class="flex-1">
                                        <h2 class="text-2xl font-bold text-gray-800 mb-2">
                                            <%= booking.concert_id.name_concert %>
                                        </h2>
                                        <p class="text-lg text-blue-600 font-semibold mb-4">
                                            <i class="fas fa-users mr-2"></i>
                                            <%= booking.concert_id.name_group %>
                                        </p>

                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                            <div>
                                                <p class="text-gray-600 mb-2">
                                                    <i class="fas fa-calendar-alt text-blue-600 mr-2"></i>
                                                    <%= new Date(booking.concert_id.date).toLocaleDateString('fr-FR', { 
                                                        weekday: 'long', 
                                                        day: 'numeric', 
                                                        month: 'long', 
                                                        year: 'numeric' 
                                                    }) %>
                                                </p>
                                                <p class="text-gray-600 mb-2">
                                                    <i class="fas fa-clock text-green-600 mr-2"></i>
                                                    <%= new Date(booking.concert_id.date).toLocaleTimeString('fr-FR', { 
                                                        hour: '2-digit', 
                                                        minute: '2-digit' 
                                                    }) %>
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-gray-600 mb-2">
                                                    <i class="fas fa-map-marker-alt text-red-600 mr-2"></i>
                                                    <%= booking.concert_id.place %>
                                                </p>
                                                <p class="text-gray-600 mb-2">
                                                    <i class="fas fa-ticket-alt text-blue-600 mr-2"></i>
                                                    <%= booking.quantity %>
                                                        <%= booking.quantity === 1 ? 'billet' : 'billets' %>
                                                </p>
                                            </div>
                                        </div>

                                        <% if (booking.qr_code) { %>
                                            <div class="bg-gray-100 p-4 rounded-lg inline-block">
                                                <img src="<%= booking.qr_code %>" alt="QR Code" class="w-32 h-32">
                                            </div>
                                            <% } %>
                                    </div>

                                    <div class="md:w-64 mt-4 md:mt-0 md:ml-6 flex flex-col justify-between">
                                        <div class="text-center md:text-right mb-4">
                                            <p class="text-sm text-gray-500 mb-1">Total payé</p>
                                            <p class="text-3xl font-bold text-green-600">
                                                <%= booking.total_price.toLocaleString() %> <span class="text-lg">FCFA</span>
                                            </p>
                                        </div>

                                        <div class="space-y-2">
                                            <a href="/bookings/<%= booking._id %>/ticket" class="block bg-green-600 hover:bg-green-700 text-white text-center py-2 px-4 rounded-lg transition font-semibold">
                                                <i class="fas fa-ticket-alt mr-2"></i>Voir mon ticket
                                            </a>

                                            <a href="/concerts/<%= booking.concert_id._id %>/detail" class="block bg-blue-600 hover:bg-blue-700 text-white text-center py-2 px-4 rounded-lg transition">
                                                <i class="fas fa-eye mr-2"></i>Détails du concert
                                            </a>

                                            <% if (new Date(booking.concert_id.date) > new Date()) { %>
                                                <form action="/bookings/<%= booking._id %>/cancel?_method=DELETE" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir annuler cette réservation ?');">
                                                    <button type="submit" class="w-full bg-red-100 hover:bg-red-200 text-red-600 py-2 px-4 rounded-lg transition">
                                                        <i class="fas fa-times-circle mr-2"></i>Annuler
                                                    </button>
                                                </form>
                                                <% } %>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4 pt-4 border-t text-xs text-gray-500">
                                    <i class="fas fa-info-circle mr-1"></i> Réservé le
                                    <%= new Date(booking.createdAt).toLocaleDateString('fr-FR', { 
                                        day: 'numeric', 
                                        month: 'long', 
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    }) %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }); %>
            </div>
            <% } else { %>
                <div class="text-center py-20">
                    <i class="fas fa-ticket-alt text-gray-300 text-9xl mb-6"></i>
                    <h2 class="text-2xl font-bold text-gray-600 mb-4">Aucune réservation</h2>
                    <p class="text-gray-500 mb-8">Vous n'avez pas encore réservé de billets pour un concert.</p>
                    <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold transition">
                        <i class="fas fa-search mr-2"></i>Découvrir les concerts
                    </a>
                </div>
                <% } %>

    </main>

    <%- include('../layout/footer') %>

</body>

</html>