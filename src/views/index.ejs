<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accueil | My Show Time</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            font-family: "Poppins", sans-serif;
            background: linear-gradient(to bottom right, #f9fafb, #eef2ff);
        }
        
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col">

    <header class="bg-blue-600 shadow-md fixed top-0 left-0 w-full z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">

                <a href="/" class="flex items-center space-x-3">
                    <div class="bg-white rounded-full p-2 shadow-lg">
                        <i class="fas fa-ticket-alt text-blue-600 text-xl"></i>
                    </div>
                    <span class="text-xl font-bold text-white">My Show Time</span>
                </a>


                <nav class="hidden md:flex items-center space-x-6">
                    <a href="/" class="text-white hover:text-blue-200 font-medium transition">Concerts</a>
                    <a href="/groups" class="text-white hover:text-blue-200 font-medium transition">Groupes</a>
                    <% if (user) { %>
                        <a href="/wishlist" class="text-white hover:text-blue-200 font-medium transition">Wishlist</a>
                        <a href="/bookings/my-bookings" class="text-white hover:text-blue-200 font-medium transition">
                        Mes Réservations
                        </a>
                        <% if (user.roles && user.roles.includes('admin')) { %>
                            <a href="/admin/dashboard" class="text-white hover:text-blue-200 font-medium transition">
                                <i class="fas fa-crown mr-2"></i>Admin
                            </a>
                            <% } %>
                                <% } %>
                </nav>


                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <a href="/users/me" class="hidden md:flex items-center space-x-2 text-white hover:text-blue-200 transition">
  
                            <img src="<%= user.photo_url || 'https://static.vecteezy.com/system/resources/previews/046/010/545/non_2x/user-icon-simple-design-free-vector.jpg' %>" alt="User" class="h-8 w-8 rounded-full border-2 border-white" />
                            <span class="font-medium"><%= user.name %></span>
                        </a>
                        <form action="/auth/logout" method="post">
                            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                                Déconnexion
                            </button>
                        </form>
                        <% } else { %>
                            <a href="/auth/login" class="text-white border border-white px-4 py-2 rounded-lg hover:bg-white hover:text-blue-600 transition">Connexion</a>
                            <a href="/auth/register" class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition">Inscription</a>
                            <% } %>
                </div>
            </div>
        </div>
    </header>

    <section class="pt-24 pb-10">
        <div class="max-w-6xl mx-auto px-6">
            <div class="relative bg-gray-900 rounded-2xl overflow-hidden shadow-lg h-[400px] flex items-center justify-center">
                <% if (featuredConcert) { %>
                    <img src="<%= featuredConcert.picture_url %>" alt="<%= featuredConcert.name_concert %>" class="absolute inset-0 w-full h-full object-cover opacity-70" />
                    <div class="relative z-10 text-center text-white">
                        <h1 class="text-4xl font-bold mb-2">
                            <%= featuredConcert.name_concert %>
                        </h1>
                        <p class="text-lg mb-3">
                            <%= featuredConcert.genre %> |
                                <%= new Date(featuredConcert.date).toLocaleDateString() %> |
                                    <%= featuredConcert.place %>
                        </p>
                        <a href="/concerts/<%= featuredConcert._id %>/detail" class="bg-white border-2 border-blue-600 text-blue-600 px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-50 transition">
                            <i class="fas fa-eye mr-2"></i>Voir détails
                        </a>
                    </div>
                    <% } else { %>
                        <div class="text-center text-white relative z-10">
                            <h1 class="text-4xl font-bold mb-2">Bienvenue sur My Show Time</h1>
                            <p class="text-lg opacity-90">Découvrez les meilleurs concerts et réservez vos places facilement.</p>
                        </div>
                        <% } %>
            </div>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 mt-4 mb-6">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4">Événements à venir</h2>

        <div class="bg-white rounded-xl shadow-md p-6 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-search mr-2"></i>Rechercher
                    </label>
                    <input type="text" id="searchFilter" placeholder="Nom du concert ou groupe..." class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" />
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-music mr-2"></i>Genre
                    </label>
                    <select id="genreFilter" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors">
                        <option value="">Tous les genres</option>
                        <option value="Rock">Rock</option>
                        <option value="Pop">Pop</option>
                        <option value="Jazz">Jazz</option>
                        <option value="Classical">Classique</option>
                        <option value="Hip-Hop">Hip-Hop</option>
                        <option value="Electronic">Électronique</option>
                        <option value="Country">Country</option>
                        <option value="Reggae">Reggae</option>
                        <option value="Blues">Blues</option>
                        <option value="Metal">Metal</option>
                        <option value="Folk">Folk</option>
                        <option value="R&B">R&B</option>
                        <option value="Soul">Soul</option>
                        <option value="Funk">Funk</option>
                        <option value="Indie">Indie</option>
                        <option value="Punk">Punk</option>
                        <option value="Latin">Latin</option>
                        <option value="World">World Music</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        <i class="fas fa-calendar-alt mr-2"></i>Trier par date
                    </label>
                    <select id="dateFilter" class="w-full px-4 py-2 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors">
                        <option value="asc">Plus récents</option>
                        <option value="desc">Plus anciens</option>
                    </select>
                </div>

            </div>

            <div class="mt-4 text-right">
                <button id="resetFilters" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                    <i class="fas fa-redo mr-2"></i>Réinitialiser
                </button>
            </div>
        </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 mt-4 mb-6">

        <% if (concerts && concerts.length > 0) { %>
            <div id="concertsContainer" class="space-y-8">
                <% concerts.forEach(concert => { %>
                    <div class="concert-card bg-white rounded-2xl shadow-lg hover:shadow-2xl transition duration-300 overflow-hidden flex flex-col md:flex-row" data-name="<%= concert.name_concert.toLowerCase() %>" data-group="<%= concert.name_group.toLowerCase() %>" data-genre="<%= concert.genre %>"
                        data-date="<%= new Date(concert.date).getTime() %>">
                        <div class="md:w-1/3 relative">
                            <img src="<%= concert.picture_url || '/images/default-concert.jpg' %>" alt="<%= concert.name_concert %>" class="w-full h-64 md:h-full object-cover" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent md:hidden"></div>
                        </div>

                        <div class="flex-1 p-6 flex flex-col justify-between">
                            <div>
                                <h3 class="text-2xl font-bold text-gray-800 mb-1">
                                    <%= concert.name_concert %>
                                </h3>
                                <p class="text-gray-600 mb-3">
                                    <span class="font-medium text-blue-700"><%= concert.name_group %></span> -
                                    <%= concert.genre %>
                                </p>
                                <p class="text-gray-500 text-sm mb-4">

                                    <%= concert.place %>
                                </p>
                                <p class="text-green-700 font-bold text-lg mb-4">

                                    <%= concert.price %> FCFA
                                </p>
                            </div>

                            <div class="flex items-center justify-between mt-4">
                                <p class="bg-blue-100 text-blue-700 px-5 py-2 rounded-lg text-sm font-medium">
                                    <i class="fas fa-calendar-alt mr-2"></i>
                                    <%= new Date(concert.date).toLocaleDateString() %>
                                </p>

                                <div class="flex space-x-2">
                                    <a href="/concerts/<%= concert._id %>/detail" class="bg-white border-2 border-blue-600 text-blue-600 px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-50 transition">
                                        <i class="fas fa-eye mr-2"></i>Voir détails
                                    </a>

                                    <% if (user) { %>
                                        <a href="/bookings/book/<%= concert._id %>" class="bg-blue-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition">
                                            <i class="fas fa-ticket-alt mr-2"></i>Réserver
                                        </a>
                                        <button onclick="toggleConcertFavorite('<%= concert._id %>')" class="flex items-center gap-1 bg-gray-100 text-red-600 px-4 py-2 rounded-lg text-sm hover:bg-gray-200 border transition" id="concert-heart-<%= concert._id %>">
                                            <i class="far fa-heart mr-1"></i>Favoris
                                        </button>
                                        <% } else { %>
                                            <a href="/auth/login" class="bg-blue-600 text-white px-5 py-2 rounded-lg text-sm font-medium hover:bg-blue-700 transition">
                                                <i class="fas fa-ticket-alt mr-2"></i>Réserver
                                            </a>
                                            <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>

            <div id="noResults" class="hidden text-center py-20">
                <i class="fas fa-search text-6xl text-gray-300 mb-4"></i>
                <p class="text-xl text-gray-500">Aucun concert ne correspond à vos critères de recherche</p>
            </div>

            <% } else { %>
                <p class="text-center text-gray-500 py-10 text-lg">
                    <i class="fas fa-music text-4xl text-gray-300 mb-4"></i><br> Aucun concert disponible pour le moment
                </p>
                <% } %>
    </section>

    <%- include('layout/footer') %>

        <script>
            // Fonction de filtrage des concerts
            function filterConcerts() {
                const searchTerm = document.getElementById('searchFilter').value.toLowerCase();
                const selectedGenre = document.getElementById('genreFilter').value;
                const dateSort = document.getElementById('dateFilter').value;

                const concertCards = document.querySelectorAll('.concert-card');
                const concertsContainer = document.getElementById('concertsContainer');
                const noResults = document.getElementById('noResults');

                let visibleCount = 0;
                let concertsArray = Array.from(concertCards);

                // Filtrage
                concertsArray.forEach(card => {
                    const name = card.dataset.name;
                    const group = card.dataset.group;
                    const genre = card.dataset.genre;

                    const matchesSearch = name.includes(searchTerm) || group.includes(searchTerm);
                    const matchesGenre = !selectedGenre || genre === selectedGenre;

                    if (matchesSearch && matchesGenre) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Tri par date
                if (visibleCount > 0) {
                    concertsArray
                        .filter(card => card.style.display !== 'none')
                        .sort((a, b) => {
                            const dateA = parseInt(a.dataset.date);
                            const dateB = parseInt(b.dataset.date);
                            return dateSort === 'asc' ? dateA - dateB : dateB - dateA;
                        })
                        .forEach(card => concertsContainer.appendChild(card));
                }

                // Afficher/masquer le message "aucun résultat"
                if (visibleCount === 0) {
                    concertsContainer.style.display = 'none';
                    noResults.classList.remove('hidden');
                } else {
                    concertsContainer.style.display = 'block';
                    noResults.classList.add('hidden');
                }
            }

            // Fonction de réinitialisation
            function resetFilters() {
                document.getElementById('searchFilter').value = '';
                document.getElementById('genreFilter').value = '';
                document.getElementById('dateFilter').value = 'asc';
                filterConcerts();
            }

            // Écouter les changements sur les filtres
            document.getElementById('searchFilter').addEventListener('input', filterConcerts);
            document.getElementById('genreFilter').addEventListener('change', filterConcerts);
            document.getElementById('dateFilter').addEventListener('change', filterConcerts);
            document.getElementById('resetFilters').addEventListener('click', resetFilters);

            // Initialiser le tri au chargement
            window.addEventListener('DOMContentLoaded', () => {
                filterConcerts();
            });
        </script>

        <script>
            async function toggleConcertFavorite(concertId) {
                const button = document.getElementById(`concert-heart-${concertId}`);
                const icon = button.querySelector('i');
                const isFavorite = icon.classList.contains('fas');

                try {
                    const method = isFavorite ? 'DELETE' : 'POST';
                    const response = await fetch(`/wishlist/concerts/${concertId}`, {
                        method: method,
                    });

                    if (response.ok) {
                        if (isFavorite) {
                            icon.classList.remove('fas');
                            icon.classList.add('far');
                        } else {
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                        }
                    } else {
                        alert('Erreur lors de la modification des favoris');
                    }
                } catch (error) {
                    console.error('Erreur:', error);
                    alert('Erreur lors de la modification des favoris');
                }
            }

            <% if (user) { %>
            async function loadFavoriteStates() {
                const concerts = [
                    <% concerts.forEach(concert => { %>
                    '<%= concert._id %>',
                    <% }); %>
                ];

                for (const concertId of concerts) {
                    try {
                        const response = await fetch(`/wishlist/concerts/${concertId}/check`);
                        const data = await response.json();

                        if (data.isFavorite) {
                            const button = document.getElementById(`concert-heart-${concertId}`);
                            if (button) {
                                const icon = button.querySelector('i');
                                icon.classList.remove('far');
                                icon.classList.add('fas');
                            }
                        }
                    } catch (error) {
                        console.error('Erreur lors du chargement des favoris:', error);
                    }
                }
            }

            window.addEventListener('DOMContentLoaded', loadFavoriteStates);
            <% } %>
        </script>
</body>

</html>