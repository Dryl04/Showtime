<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un Concert - MyShowTime</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">

    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/dashboard" class="flex items-center hover:text-blue-200 transition">
                        <i class="fas fa-arrow-left mr-3 text-xl"></i>
                        <h1 class="text-xl font-semibold">Retour au Dashboard</h1>
                    </a>
                </div>
                <div class="flex items-center">
                    <a href="/" class="hover:text-blue-200 transition">
                        <i class="fas fa-home mr-2"></i>Accueil
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="text-center mb-10">
            <div class="inline-block p-4 bg-green-100 rounded-full mb-4">
                <i class="fas fa-calendar-plus text-green-600 text-4xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-2">Créer un Concert</h1>
            <p class="text-gray-600">Ajoutez un nouveau concert à la plateforme</p>
        </div>

        <div class="card p-8">
            <form action="/concerts" method="POST" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label for="name_group" class="block text-sm font-medium text-gray-700 mb-2">
                        Groupe/Artiste *
                    </label>
                        <input type="text" id="name_group" name="name_group" required minlength="2" maxlength="200" title="Le nom du groupe doit contenir entre 2 et 200 caractères" class="form-input" placeholder="Nom du groupe ou artiste">
                    </div>

                    <div class="md:col-span-2">
                        <label for="name_concert" class="block text-sm font-medium text-gray-700 mb-2">
                        Nom du concert *
                    </label>
                        <input type="text" id="name_concert" name="name_concert" required minlength="2" maxlength="200" title="Le nom du concert doit contenir entre 2 et 200 caractères" class="form-input" placeholder="Titre du concert">
                    </div>

                    <div>
                        <label for="genre" class="block text-sm font-medium text-gray-700 mb-2">
                        Genre musical *
                    </label>
                        <input type="text" id="genre" name="genre" required maxlength="100" title="Le genre doit contenir maximum 100 caractères" class="form-input" placeholder="Rock, Pop, Jazz...">
                    </div>

                    <div>
                        <label for="date" class="block text-sm font-medium text-gray-700 mb-2">
                        Date et heure *
                    </label>
                        <input type="datetime-local" id="date" name="date" required title="Veuillez sélectionner une date et heure pour le concert" class="form-input">
                    </div>

                    <div class="md:col-span-2">
                        <label for="place" class="block text-sm font-medium text-gray-700 mb-2">
                        Lieu *
                    </label>
                        <input type="text" id="place" name="place" required minlength="2" maxlength="300" title="Le lieu doit contenir entre 2 et 300 caractères" class="form-input" placeholder="Salle de concert, adresse...">
                    </div>

                    <div class="md:col-span-2">
                        <label for="picture_url" class="block text-sm font-medium text-gray-700 mb-2">
                        URL de l'image
                    </label>
                        <input type="url" id="picture_url" name="picture_url" maxlength="2000" title="Veuillez entrer une URL valide (max 2000 caractères)" class="form-input" placeholder="https://example.com/image.jpg">
                    </div>

                    <div>
                        <label for="price" class="block text-sm font-medium text-gray-700 mb-2">
                        Prix (FCFA)
                    </label>
                        <input type="number" id="price" name="price" min="0" max="10000000" step="0.01" title="Le prix doit être entre 0 et 10 000 000 FCFA" class="form-input" placeholder="1000">
                    </div>

                    <div>
                        <label for="number_of_ticket" class="block text-sm font-medium text-gray-700 mb-2">
                        Billets disponibles *
                    </label>
                        <input type="number" id="number_of_ticket" name="number_of_ticket" min="0" max="100000" required title="Le nombre de billets doit être entre 0 et 100 000" class="form-input" placeholder="0">
                    </div>
                </div>

                <input type="hidden" name="user_id" value="507f1f77bcf86cd799439011">

                <div class="flex flex-col sm:flex-row gap-4 justify-end pt-6 border-t border-gray-200 mt-8">
                    <a href="/admin/dashboard" class="flex items-center justify-center bg-gray-500 text-white hover:bg-gray-600 px-6 py-3 rounded-lg transition-all shadow-sm">
                        <i class="fas fa-arrow-left mr-2"></i> Annuler
                    </a>
                    <button type="submit" class="flex items-center justify-center bg-green-600 text-white hover:bg-green-700 px-8 py-3 rounded-lg font-semibold transition-all shadow-md">
                    <i class="fas fa-plus-circle mr-2"></i>
                    Créer le concert
                </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Footer
    <footer class="bg-gray-800 text-white text-center py-6 mt-20">
        <p>&copy; 2025 MyShowTime - Admin Panel</p>
    </footer> -->

    <style>
        .card {
            background: white;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 2px solid #e5e7eb;
            border-radius: 0.5rem;
            font-size: 1rem;
            transition: all 0.2s;
        }
        
        .form-input:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }
        
        .form-input::placeholder {
            color: #9ca3af;
        }
    </style>

    <%- include('../layout/footer') %>

</body>

</html>