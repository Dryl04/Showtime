<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier le Concert - MyShowTime</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen">

    <nav class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/admin/dashboard" class="flex items-center hover:text-blue-200 transition">
                        <i class="fas fa-arrow-left mr-3 text-xl"></i>
                        <h1 class="text-xl font-semibold">Retour au Dashboard</h1>
                    </a>
                </div>
                <div class="flex items-center">
                    <a href="/" class="hover:text-blue-200 transition">
                        <i class="fas fa-home mr-2"></i>Accueil
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="text-center mb-10">
            <div class="inline-block p-4 bg-blue-100 rounded-full mb-4">
                <i class="fas fa-edit text-blue-600 text-4xl"></i>
            </div>
            <h1 class="text-4xl font-bold text-gray-800 mb-2">Modifier le Concert</h1>
            <p class="text-gray-600">Modifiez les informations du concert
                <%= concert.name_concert %>
            </p>
        </div>

        <div class="bg-white rounded-2xl shadow-xl p-8">

            <% if (locals.error) { %>
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <p>
                            <%= error %>
                        </p>
                    </div>
                </div>
                <% } %>

                    <form action="/concerts/<%= concert._id %>?_method=PUT" method="POST" class="space-y-8">

                        <div class="border-b pb-6">
                            <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-info-circle text-blue-600 mr-2"></i> Informations Générales
                            </h2>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                                <div class="md:col-span-2">
                                    <label for="name_concert" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-music text-blue-600 mr-2"></i>Nom du Concert *
              </label>
                                    <input type="text" id="name_concert" name="name_concert" required value="<%= concert.name_concert %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex: World Tour 2025">
                                </div>

                                <div class="md:col-span-2">
                                    <label for="name_group" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-users text-blue-600 mr-2"></i>Groupe/Artiste *
              </label>
                                    <input type="text" id="name_group" name="name_group" required value="<%= concert.name_group %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex: Coldplay">
                                </div>

                                <div>
                                    <label for="genre" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-guitar text-blue-600 mr-2"></i>Genre Musical *
              </label>
                                    <input type="text" id="genre" name="genre" required value="<%= concert.genre %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex: Rock, Pop, Jazz...">
                                </div>

                                <div>
                                    <label for="place" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-map-marker-alt text-blue-600 mr-2"></i>Lieu *
              </label>
                                    <input type="text" id="place" name="place" required value="<%= concert.place %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="Ex: Stade de France, Paris">
                                </div>

                            </div>
                        </div>

                        <div class="border-b pb-6">
                            <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-calendar-alt text-green-600 mr-2"></i> Date et Heure
                            </h2>

                            <div>
                                <label for="date" class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-clock text-green-600 mr-2"></i>Date et Heure du Concert *
            </label>
                                <input type="datetime-local" id="date" name="date" required value="<%= new Date(concert.date).toISOString().slice(0, 16) %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-green-500 transition-colors">
                            </div>
                        </div>

                        <div class="border-b pb-6">
                            <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-ticket-alt text-yellow-600 mr-2"></i> Billets et Prix
                            </h2>

                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                                <div>
                                    <label for="price" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-tag text-yellow-600 mr-2"></i>Prix (FCFA) *
              </label>
                                    <input type="number" id="price" name="price" required min="0" step="0.01" value="<%= concert.price || 0 %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-yellow-500 transition-colors" placeholder="0">
                                </div>

                                <div>
                                    <label for="number_of_ticket" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-inbox text-yellow-600 mr-2"></i>Total Tickets *
              </label>
                                    <input type="number" id="number_of_ticket" name="number_of_ticket" required min="0" value="<%= concert.number_of_ticket || 0 %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-yellow-500 transition-colors"
                                        placeholder="0">
                                </div>

                                <div>
                                    <label for="ticket_left" class="block text-sm font-semibold text-gray-700 mb-2">
                <i class="fas fa-boxes text-yellow-600 mr-2"></i>Tickets Restants
              </label>
                                    <input type="number" id="ticket_left" name="ticket_left" min="0" value="<%= concert.ticket_left || 0 %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-yellow-500 transition-colors bg-gray-50" placeholder="0">
                                    <p class="text-xs text-gray-500 mt-1">Calculé automatiquement</p>
                                </div>

                            </div>

                            <div class="mt-4 bg-gray-50 p-4 rounded-lg">
                                <p class="text-sm text-gray-700">
                                    <strong>Tickets vendus :</strong>
                                    <%= concert.ticket_sold || 0 %>
                                </p>
                            </div>
                        </div>

                        <div class="border-b pb-6">
                            <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                                <i class="fas fa-image text-blue-600 mr-2"></i> Image du Concert
                            </h2>

                            <div>
                                <label for="picture_url" class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-link text-blue-600 mr-2"></i>URL de l'Image
            </label>
                                <input type="url" id="picture_url" name="picture_url" value="<%= concert.picture_url || '' %>" class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 transition-colors" placeholder="https://example.com/image.jpg">
                            </div>

                            <% if (concert.picture_url) { %>
                                <div class="mt-4">
                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
              <i class="fas fa-eye text-blue-600 mr-2"></i>Prévisualisation Actuelle
            </label>
                                    <div class="border-2 border-gray-200 rounded-lg p-4 bg-gray-50">
                                        <img id="preview-img" src="<%= concert.picture_url %>" alt="Prévisualisation" class="w-full h-64 object-cover rounded-lg">
                                    </div>
                                </div>
                                <% } %>
                        </div>

                        <div class="flex space-x-4 pt-6">
                            <button type="submit" class="flex-1 bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition-all duration-300 shadow-lg hover:shadow-xl">
            <i class="fas fa-save mr-2"></i>Sauvegarder
          </button>
                            <a href="/admin/dashboard" class="flex-1 bg-gray-200 text-gray-700 px-6 py-3 rounded-lg font-semibold hover:bg-gray-300 transition-colors text-center">
                                <i class="fas fa-times mr-2"></i>Annuler
                            </a>
                        </div>

                    </form>
        </div>

    </div>

    <!-- JavaScript pour la prévisualisation -->
    <script>
        const pictureUrlInput = document.getElementById('picture_url');
        const previewImg = document.getElementById('preview-img');

        if (pictureUrlInput && previewImg) {
            pictureUrlInput.addEventListener('input', function() {
                const url = this.value.trim();

                if (url && (url.startsWith('http://') || url.startsWith('https://'))) {
                    previewImg.src = url;
                }
            });
        }
    </script>

    <%- include('../layout/footer') %>

</body>

</html>