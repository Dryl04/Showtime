<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= concert.name_concert %> - MyShowTime</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: "Poppins", sans-serif;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col bg-gray-50">

    <header class="bg-blue-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <a href="/" class="flex items-center space-x-3">
                    <div class="bg-white rounded-full p-2 shadow-lg">
                        <i class="fas fa-ticket-alt text-blue-600 text-xl"></i>
                    </div>
                    <span class="text-xl font-bold">My Show Time</span>
                </a>

                <nav class="hidden md:flex items-center space-x-6">
                    <a href="/" class="text-white hover:text-blue-200 font-medium transition">Concerts</a>
                    <a href="/groups" class="text-white hover:text-blue-200 font-medium transition">Groupes</a>
                    <% if (user) { %>
                        <a href="/wishlist" class="text-white hover:text-blue-200 font-medium transition">Wishlist</a>
                        <% } %>
                </nav>

                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <a href="/users/me" class="text-white hover:text-blue-200 transition">
                            <i class="fas fa-user mr-2"></i>
                            <%= user.name %>
                        </a>
                        <form action="/auth/logout" method="post" class="inline">
                            <button type="submit" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition">
                                Déconnexion
                            </button>
                        </form>
                        <% } else { %>
                            <a href="/auth/login" class="text-white hover:text-blue-200 transition">Connexion</a>
                            <a href="/auth/register" class="bg-white text-blue-600 px-4 py-2 rounded-lg hover:bg-blue-50 transition">Inscription</a>
                            <% } %>
                </div>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

        <div class="mb-6">
            <a href="/" class="inline-flex items-center text-blue-600 hover:text-blue-800 transition">
                <i class="fas fa-arrow-left mr-2"></i> Retour aux concerts
            </a>
        </div>

        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">

            <% if (concert.picture_url) { %>
                <img src="<%= concert.picture_url %>" alt="<%= concert.name_concert %>" class="w-full h-96 object-cover">
                <% } else { %>
                    <div class="w-full h-96 bg-blue-600 flex items-center justify-center">
                        <i class="fas fa-music text-white text-9xl"></i>
                    </div>
                    <% } %>

                        <div class="p-8">
                            <div class="flex flex-col lg:flex-row justify-between items-start gap-8 mb-8">

                                <div class="flex-1">
                                    <h1 class="text-4xl font-bold text-gray-800 mb-2">
                                        <%= concert.name_concert %>
                                    </h1>
                                    <p class="text-2xl text-blue-600 font-semibold mb-6">
                                        <i class="fas fa-users mr-2"></i>
                                        <%= concert.name_group %>
                                    </p>

                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                                        <div class="flex items-start space-x-3">
                                            <i class="fas fa-calendar-alt text-blue-600 text-2xl mt-1"></i>
                                            <div>
                                                <p class="text-sm text-gray-500 font-medium">Date et heure</p>
                                                <p class="text-lg font-semibold text-gray-800">
                                                    <%= new Date(concert.date).toLocaleDateString('fr-FR', { 
                                            weekday: 'long', 
                                            day: 'numeric', 
                                            month: 'long', 
                                            year: 'numeric'
                                        }) %>
                                                </p>
                                                <p class="text-gray-600">
                                                    <%= new Date(concert.date).toLocaleTimeString('fr-FR', { 
                                            hour: '2-digit', 
                                            minute: '2-digit' 
                                        }) %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex items-start space-x-3">
                                            <i class="fas fa-map-marker-alt text-red-600 text-2xl mt-1"></i>
                                            <div>
                                                <p class="text-sm text-gray-500 font-medium">Lieu</p>
                                                <p class="text-lg font-semibold text-gray-800">
                                                    <%= concert.place %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex items-start space-x-3">
                                            <i class="fas fa-music text-green-600 text-2xl mt-1"></i>
                                            <div>
                                                <p class="text-sm text-gray-500 font-medium">Genre</p>
                                                <p class="text-lg font-semibold text-gray-800">
                                                    <%= concert.genre %>
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex items-start space-x-3">
                                            <i class="fas fa-ticket-alt text-blue-600 text-2xl mt-1"></i>
                                            <div>
                                                <p class="text-sm text-gray-500 font-medium">Billets disponibles</p>
                                                <p class="text-lg font-semibold text-gray-800">
                                                    <%= concert.ticket_left || 0 %> /
                                                        <%= concert.number_of_ticket || 0 %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="lg:w-96">
                                    <div class="bg-gradient-to-br from-green-50 to-blue-50 rounded-xl p-6 shadow-lg border-2 border-green-200">
                                        <div class="text-center mb-4">
                                            <p class="text-sm text-gray-600 font-medium mb-2">Prix du billet</p>
                                            <p class="text-5xl font-bold text-green-600 mb-2">
                                                <%= concert.price %> <span class="text-2xl">FCFA</span>
                                            </p>
                                        </div>

                                        <% if ((concert.ticket_left || 0) > 0) { %>
                                            <% if (user) { %>
                                                <a href="/bookings/book/<%= concert._id %>" class="block w-full bg-green-600 hover:bg-green-700 text-white text-center py-4 rounded-lg font-bold text-lg shadow-lg hover:shadow-xl transition transform hover:scale-105 mb-3">
                                                    <i class="fas fa-ticket-alt mr-2"></i>Réserver maintenant
                                                </a>
                                                <% } else { %>
                                                    <a href="/auth/login" class="block w-full bg-green-600 hover:bg-green-700 text-white text-center py-4 rounded-lg font-bold text-lg shadow-lg hover:shadow-xl transition transform hover:scale-105 mb-3">
                                                        <i class="fas fa-sign-in-alt mr-2"></i>Se connecter pour réserver
                                                    </a>
                                                    <% } %>

                                                        <% if (user) { %>
                                                            <button onclick="toggleConcertFavorite('<%= concert._id %>')" id="concert-heart-<%= concert._id %>" class="w-full flex items-center justify-center gap-2 bg-red-100 text-red-600 py-3 rounded-lg hover:bg-red-200 transition">
                                        <i class="far fa-heart text-xl"></i>
                                        <span class="font-semibold">Ajouter aux favoris</span>
                                    </button>
                                                            <% } %>
                                                                <% } else { %>
                                                                    <div class="bg-red-100 border-2 border-red-400 text-red-700 text-center py-4 rounded-lg font-bold text-lg">
                                                                        <i class="fas fa-exclamation-triangle mr-2"></i>Complet
                                                                    </div>
                                                                    <% } %>

                                                                        <p class="text-xs text-gray-500 text-center mt-4">
                                                                            <i class="fas fa-shield-alt mr-1"></i>Paiement sécurisé
                                                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
        </div>

    </main>

    <script>
        async function toggleConcertFavorite(concertId) {
            const button = document.getElementById(`concert-heart-${concertId}`);
            const icon = button.querySelector('i');
            const text = button.querySelector('span');
            const isFavorite = icon.classList.contains('fas');

            try {
                const method = isFavorite ? 'DELETE' : 'POST';
                const response = await fetch(`/wishlist/concerts/${concertId}`, {
                    method: method,
                });

                if (response.ok) {
                    if (isFavorite) {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        button.classList.remove('bg-red-200', 'text-red-700');
                        button.classList.add('bg-red-100', 'text-red-600');
                        text.textContent = 'Ajouter aux favoris';
                    } else {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        button.classList.remove('bg-red-100', 'text-red-600');
                        button.classList.add('bg-red-200', 'text-red-700');
                        text.textContent = 'Retirer des favoris';
                    }
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        }

        <% if (user) { %>
        async function checkFavoriteStatus() {
            try {
                const response = await fetch('/wishlist/concerts/<%= concert._id %>/check');
                const data = await response.json();

                if (data.isFavorite) {
                    const button = document.getElementById('concert-heart-<%= concert._id %>');
                    const icon = button.querySelector('i');
                    const text = button.querySelector('span');
                    icon.classList.remove('far');
                    icon.classList.add('fas');
                    button.classList.remove('bg-red-100', 'text-red-600');
                    button.classList.add('bg-red-200', 'text-red-700');
                    text.textContent = 'Retirer des favoris';
                }
            } catch (error) {
                console.error('Erreur vérification wishlist:', error);
            }
        }

        window.addEventListener('DOMContentLoaded', checkFavoriteStatus);
        <% } %>
    </script>

    <%- include('../layout/footer') %>

</body>

</html>