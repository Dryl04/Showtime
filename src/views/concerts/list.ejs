<% const body = %>
    <div class="space-y-8">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-4 md:space-y-0">
            <div>
                <h2 class="text-3xl font-bold text-gray-900">🎵 Liste des Concerts</h2>
                <p class="text-gray-600 mt-2">Découvrez tous les concerts programmés</p>
            </div>
            <a href="/concerts/create" class="btn-primary flex items-center space-x-2 px-6 py-3 rounded-lg">
                <span>➕</span>
                <span>Nouveau Concert</span>
            </a>
        </div>

        <% if (concerts.length === 0) { %>
            <div class="card p-12 text-center">
                <div class="text-6xl mb-4">🎭</div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">Aucun concert programmé</h3>
                <p class="text-gray-600 mb-6">Commencez par créer votre premier concert !</p>
                <a href="/concerts/create" class="btn-primary text-lg px-8 py-3 rounded-lg">
                Créer mon premier concert
            </a>
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% concerts.forEach(concert => { %>
                        <div class="card hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                            <% if (concert.picture_url) { %>
                                <img src="<%= concert.picture_url %>" alt="<%= concert.name_concert %>" class="w-full h-48 object-cover">
                                <% } else { %>
                                    <div class="w-full h-48 bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                                        <span class="text-6xl text-white">🎵</span>
                                    </div>
                                    <% } %>

                                        <!-- Contenu -->
                                        <div class="p-6 space-y-4">
                                            <!-- Titre et groupe -->
                                            <div>
                                                <h3 class="text-xl font-bold text-gray-900 line-clamp-2">
                                                    <%= concert.name_concert %>
                                                </h3>
                                                <p class="text-blue-600 font-semibold mt-1">
                                                    <%= concert.name_group %>
                                                </p>
                                            </div>

                                            <!-- Infos -->
                                            <div class="space-y-2">
                                                <div class="flex items-center space-x-2 text-gray-600">
                                                    <span>🎵</span>
                                                    <span class="text-sm"><%= concert.genre %></span>
                                                </div>
                                                <div class="flex items-center space-x-2 text-gray-600">
                                                    <span>📅</span>
                                                    <span class="text-sm"><%= new Date(concert.date).toLocaleDateString('fr-FR', { 
                                    weekday: 'long', 
                                    year: 'numeric', 
                                    month: 'long', 
                                    day: 'numeric',
                                    hour: '2-digit',
                                    minute: '2-digit'
                                }) %></span>
                                                </div>
                                                <div class="flex items-center space-x-2 text-gray-600">
                                                    <span>📍</span>
                                                    <span class="text-sm"><%= concert.place %></span>
                                                </div>
                                            </div>

                                            <!-- Prix et billets -->
                                            <div class="flex justify-between items-center pt-4 border-t border-gray-200">
                                                <div class="text-2xl font-bold text-green-600">
                                                    <%= concert.price %> €
                                                </div>
                                                <div class="text-right">
                                                    <div class="text-sm font-medium text-gray-900">
                                                        <%= concert.ticket_dispo %> billets</div>
                                                    <div class="text-xs text-gray-500">disponibles</div>
                                                </div>
                                            </div>

                                            <!-- Actions -->
                                            <div class="flex space-x-2 pt-4">
                                                <a href="/concerts/<%= concert._id %>" class="bg-blue-600 text-white hover:bg-blue-700 px-3 py-2 rounded text-sm flex-1 text-center transition-colors">
                                👀 Voir
                            </a>
                                                <a href="/concerts/<%= concert._id %>/edit" class="bg-yellow-600 text-white hover:bg-yellow-700 px-3 py-2 rounded text-sm flex-1 text-center transition-colors">
                                ✏️ Modifier
                            </a>
                                                <form action="/concerts/<%= concert._id %>" method="POST" class="flex-1">
                                                    <input type="hidden" name="_method" value="DELETE">
                                                    <button type="submit" onclick="return confirmDelete()" class="bg-red-600 text-white hover:bg-red-700 w-full px-3 py-2 rounded text-sm transition-colors">
                                    🗑️ Suppr.
                                </button>
                                                </form>
                                            </div>
                                        </div>
                        </div>
                        <% }); %>
                </div>
                <% } %>
    </div>
    <% } %>
        <%- include('../layout/template', { body }) %>